								"text": "Supports"
							}
						},
						{
							"name": "calDescription",
							"dataSource": "This.descriptionText",
							"width": 260,
							"truncateMode": "none",
							"header": {
								"name": "hdrCalDescription",
								"text": "Description"
							}
						}
					]
				},
				"grpRequest": {
					"type": "groupBox",
					"left": 660,
					"top": 396,
					"width": 500,
					"height": 444,
