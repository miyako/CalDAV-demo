{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 1000,
	"windowMinHeight": 700,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 20,
	"bottomMargin": 20,
	"width": 1180,
	"height": 880,
	"events": [
		"onLoad"
	],
	"windowTitle": "CalDAV demo — miyako/CalDAV component",
	"destination": "detailScreen",
	"method": "method.4dm",
	"formClass": "DemoForm",
	"pages": [
		{
			"objects": {
