					"dataSourceTypeHint": "text",
					"enterable": false,
					"hideFocusRing": true
				},
				"lblComponent": {
					"type": "text",
					"left": 36,
					"top": 314,
					"width": 92,
					"height": 20,
					"text": "Component"
				},
				"versionInput": {
					"type": "input",
					"left": 132,
					"top": 310,
					"width": 492,
					"height": 22,
					"dataSource": "Form.versionText",
					"dataSourceTypeHint": "text",
					"enterable": false,
					"hideFocusRing": true,
					"borderStyle": "none"
				},
				"grpExplain": {
					"type": "groupBox",
					"left": 20,
					"top": 396,
					"width": 620,
					"height": 444,
					"text": "What this page proves"
				},
				"explainText": {
					"type": "text",
					"left": 36,
					"top": 424,
					"width": 588,
					"height": 400,
					"text": "The component ships its CLI as a resource; 4D runs it as a child\nprocess and reads JSON from stdin. Nothing is linked in-process.\n\nDiscover walks three PROPFIND calls:\n  1. the start URL answers current-user-principal\n  2. the principal answers calendar-home-set\n  3. the home is listed at Depth 1 for calendar collections\n\nThe password never becomes a process argument. It travels in the\nJSON on stdin, and only transiently in the caller's request object.\n\nThe right panel shows the redacted request exactly as it was sent.\n\nPoint the URL at a real CalDAV server, unsend the loopback opt-in and\nsupply TLS credentials: only the URL and the checkbox need to change."
				},
				"grpCalendars": {
					"type": "groupBox",
					"left": 660,
					"top": 84,
					"width": 500,
					"height": 300,
					"text": "Calendars reported by the home collection"
				},
				"calendarList": {
					"type": "listbox",
					"listboxType": "collection",
					"left": 672,
					"top": 112,
					"width": 470,
					"height": 256,
					"dataSource": "Form.calendars",
					"currentItemSource": "Form.selectedCalendar",
					"rowHeight": "24px",
					"verticalAlign": "middle",
					"resizingMode": "legacy",
					"method": "ObjectMethods/calendarList.4dm",
					"events": [
						"onClick"
					],
					"columns": [
						{
							"name": "calName",
							"dataSource": "This.name",
