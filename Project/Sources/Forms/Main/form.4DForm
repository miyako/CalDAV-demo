				},
				"versionText": {
					"type": "input",
					"left": 740,
					"top": 16,
					"width": 420,
					"height": 20,
					"dataSource": "Form.versionText",
					"dataSourceTypeHint": "text",
					"enterable": false,
					"hideFocusRing": true,
